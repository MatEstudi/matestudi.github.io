{
  "rules": {
    "presence": {
      ".read": "auth!=null",
      ".indexOn": [
        "lastSeen"
      ],
      "$uid": {
        ".write": "auth!=null && (auth.uid===$uid || (data.exists() && !newData.exists() && data.child('lastSeen').val() < now-2592000000))",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "since": {
          ".validate": "newData.isNumber()"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length>=3 && newData.val().length<=20 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && root.child('usernames').child(newData.val().toLowerCase()).val()===auth.uid"
        },
        "avatarColor": {
          ".validate": "newData.isString() && newData.val().length<=7"
        },
        "active": {
          ".validate": "newData.isString() && newData.val().length<=30"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      "general": {
        ".read": "auth!=null",
        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "auth!=null && ((!data.exists() && newData.child('uid').val()===auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val()===auth.uid || data.child('ts').val() < now-604800000)))",
          ".validate": "newData.hasChildren(['uid','nick','text','ts','color']) && newData.child('text').isString() && newData.child('text').val().length>0 && newData.child('text').val().length<=300 && newData.child('nick').isString() && newData.child('nick').val().length<=20 && newData.child('color').isString() && newData.child('color').val().length<=7 && newData.child('ts').val()===now",
          "uid": {
            ".validate": true
          },
          "nick": {
            ".validate": "newData.isString() && newData.val().length>=3 && newData.val().length<=20 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && root.child('usernames').child(newData.val().toLowerCase()).val()===auth.uid"
          },
          "text": {
            ".validate": true
          },
          "ts": {
            ".validate": true
          },
          "color": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "usernames": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))",
        ".validate": "newData.isString() && newData.val() === auth.uid && $key.matches(/^[a-z0-9_-]+$/) && $key.length >= 3 && $key.length <= 20"
      }
    }
  }
}
